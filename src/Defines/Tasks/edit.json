{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/tasks",
    "components": [
        {
            "type": "function",
            "function": "breadcrumbEdit"
        },
        {
            "type": "div",
            "class": "row",
            "components": [
                {
                    "type": "div",
                    "class": "col-lg-12",
                    "components": [
                        {
                            "type": "form",
                            "class": "",
                            "id": "frm-sfw-tasks-edit",
                            "action": "sfw/tasks/{id}",
                            "components": [
                                {
                                    "type": "tabs",
                                    "components": [
                                        {
                                            "type": "tab",
                                            "title": "general",
                                            "key": "general",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "card",
                                                    "components": [
                                                        {
                                                            "type": "div",
                                                            "class": "card-body",
                                                            "components": [
                                                                {
                                                                    "type": "select",
                                                                    "required": true,
                                                                    "title": "status",
                                                                    "field": "status",
                                                                    "selector": "selectStatuses"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "type": "div",
                                                            "class": "card-footer",
                                                            "components": [
                                                                {
                                                                    "type": "button",
                                                                    "action": "js:sfwcomponent.submit('frm-sfw-tasks-edit')",
                                                                    "title": "accept",
                                                                    "class": "btn btn-primary"
                                                                },
                                                                {
                                                                    "type": "button",
                                                                    "action": "link:sfw/tasks",
                                                                    "title": "cancel",
                                                                    "class": "btn btn-secondary"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
