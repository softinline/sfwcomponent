{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/languages",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbEdit"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "class": "",
                                    "id": "frm-sfw-languages-edit",
                                    "action": "sfw/languages/{id}",
                                    "components": [
                                        {
                                            "type": "div",
                                            "class": "card",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "card-body",
                                                    "components": [
                                                        {
                                                            "type": "text",
                                                            "title": "id",
                                                            "field": "id",
                                                            "readonly": true
                                                        },
                                                        {
                                                            "type": "text",
                                                            "required": true,
                                                            "title": "language",
                                                            "field": "language"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "name",
                                                            "field": "name"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "required": true,
                                                            "title": "iso",
                                                            "field": "iso"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "locale",
                                                            "field": "locale"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "sort_order",
                                                            "field": "sort_order"
                                                        },
                                                        {
                                                            "type": "checkbox",
                                                            "title": "is_active",
                                                            "field": "is_active"
                                                        },
                                                        {
                                                            "type": "checkbox",
                                                            "title": "is_default",
                                                            "field": "is_default"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "class": "card-footer",
                                                    "components": [
                                                        {
                                                            "type": "button",
                                                            "action": "js:sfwcomponent.submit('frm-sfw-languages-edit')",
                                                            "title": "accept",
                                                            "class": "btn btn-primary",
                                                            "icon": "las la-save"
                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/languages",
                                                            "title": "cancel",
                                                            "class": "btn btn-secondary",
                                                            "icon": "las la-times"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "translationFile": "sfwcomponent::"
}
