{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/users",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbEdit"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "class": "",
