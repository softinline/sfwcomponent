                                    "action": "sfw/users/{id}",
                                    "components": [
                                        {
                                            "type": "div",
                                            "class": "card",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "card-body",
                                                    "components": [
                                                        {
                                                            "type": "text",
                                                            "title": "name",
                                                            "field": "name",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "email",
                                                            "title": "email",
                                                            "field": "email",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "password",
                                                            "title": "password",
                                                            "field": "password"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "role",
                                                            "field": "role"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "status",
                                                            "field": "status"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "lover_level",
                                                            "field": "lover_level"
