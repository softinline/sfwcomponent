                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/users/{id}/objects-access",
                                                            "title": "Permisos",
                                                            "class": "btn btn-info"
                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/users",
                                                            "title": "cancel",
                                                            "class": "btn btn-secondary"
