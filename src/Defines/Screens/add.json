{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "add",
    "url": "sfw/screens",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbAdd"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "class": "",
                                    "id": "frm-sfw-screens-add",
                                    "action": "sfw/screens/add",
                                    "components": [
                                        {
                                            "type": "tabs",
                                            "components": [
                                                {
                                                    "type": "tab",
                                                    "title": "general",
                                                    "key": "general",
                                                    "components": [
                                                        {
                                                            "type": "div",
                                                            "class": "card",
                                                            "components": [
                                                                {
                                                                    "type": "div",
                                                                    "class": "card-body",
                                                                    "components": [
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "name",
                                                                            "field": "name",
                                                                            "help": "help_screen_name"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": false,
                                                                            "title": "key",
                                                                            "field": "key",
                                                                            "help": "help_screen_key"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "layout",
                                                                            "field": "layout",
                                                                            "help": "help_screen_layout"
                                                                        },
                                                                        {
                                                                            "type": "select",
                                                                            "required": true,
                                                                            "title": "ajax",
                                                                            "field": "ajax",
                                                                            "selector": "selectAjaxOptions",
                                                                            "help": "help_screen_ajax"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "url",
                                                                            "field": "url",
                                                                            "help": "help_screen_url"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "translation_file",
                                                                            "field": "translation_file",
                                                                            "help": "help_screen_translation_file"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "div",
                                                                    "class": "card-footer",
                                                                    "components": [
                                                                        {
                                                                            "type": "button",
                                                                            "action": "js:sfwcomponent.submit('frm-sfw-screens-add')",
                                                                            "title": "accept",
                                                                            "class": "btn btn-primary",
                                                                            "icon": "las la-save"
                                                                        },
                                                                        {
                                                                            "type": "button",
                                                                            "action": "link:sfw/screens",
                                                                            "title": "cancel",
                                                                            "class": "btn btn-secondary",
                                                                            "icon": "las la-times"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "translationFile": "sfwcomponent::"
}
