{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "detail",
    "url": "sfw/screens",
    "translationFile": "sfwcomponent::",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbDetail"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "div",
                                    "class": "card",
                                    "components": [
                                        {
                                            "type": "div",
                                            "class": "card-body",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "col-lg-12 text-right",
                                                    "components": [
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/screens/{id}/components/add",
                                                            "title": "add",
                                                            "class": "btn btn-primary mb-2",
                                                            "icon": "las la-plus-circle",
                                                            "id": "btnAdd"
                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "js:sfwSaveScreenTree('{id}')",
                                                            "title": "save",
                                                            "class": "btn btn-success mb-2",
                                                            "icon": "las la-save",
                                                            "id": "btnSave"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "class": "col-lg-12",
                                                    "components": [
                                                        {
                                                            "type": "function",
                                                            "function": "generateTree"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
