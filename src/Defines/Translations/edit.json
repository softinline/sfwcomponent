{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/translations",
    "translationFile": "sfwcomponent::",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbEdit"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "class": "",
                                    "id": "frm-sfw-translations-edit",
                                    "action": "sfw/translations/{id}",
                                    "components": [
                                        {
                                            "type": "div",
                                            "class": "card",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "card-body",
                                                    "components": [
                                                        {
                                                            "type": "text",
                                                            "title": "table",
                                                            "field": "table"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "row_id",
                                                            "field": "row_id"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "field",
                                                            "field": "field"
                                                        },
                                                        {
                                                            "type": "textarea",
                                                            "title": "translation",
                                                            "field": "translation",
                                                            "rows": "12"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "class": "card-footer",
                                                    "components": [
                                                        {
                                                            "type": "button",
                                                            "action": "js:sfwcomponent.submit('frm-sfw-translations-edit')",
                                                            "title": "accept",
                                                            "class": "btn btn-primary",
                                                            "icon": "las la-save"
                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/translations",
                                                            "title": "cancel",
                                                            "class": "btn btn-secondary",
                                                            "icon": "las la-times"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
