{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/email-templates",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbEdit"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "class": "",
                                    "id": "frm-sfw-email-templates-edit",
                                    "action": "sfw/email-templates/{id}",
                                    "components": [
                                        {
                                            "type": "tabs",
                                            "components": [
                                                {
                                                    "type": "tab",
                                                    "title": "general",
                                                    "key": "general",
                                                    "components": [
                                                        {
                                                            "type": "div",
                                                            "class": "card",
                                                            "components": [
                                                                {
                                                                    "type": "div",
                                                                    "class": "card-body",
                                                                    "components": [
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "email_template",
                                                                            "field": "email_template"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "key",
                                                                            "field": "key"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": true,
                                                                            "title": "subject",
                                                                            "field": "subject",
                                                                            "translate": true,
                                                                            "translations": "getTranslations",
                                                                            "languages": "languages"
                                                                        },
                                                                        {
                                                                            "type": "ckeditor",
                                                                            "required": true,
                                                                            "title": "body",
                                                                            "field": "body",
                                                                            "translate": true,
                                                                            "translations": "getTranslations",
                                                                            "languages": "languages"
                                                                        },
                                                                        {
                                                                            "type": "text",
                                                                            "required": false,
                                                                            "title": "layout",
                                                                            "field": "layout"
                                                                        },
                                                                        {
                                                                            "type": "checkbox",
                                                                            "required": false,
                                                                            "title": "is_default",
                                                                            "field": "default"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "div",
                                                                    "class": "card-footer",
                                                                    "components": [
                                                                        {
                                                                            "type": "button",
                                                                            "action": "js:sfwcomponent.submit('frm-sfw-email-templates-edit')",
                                                                            "title": "accept",
                                                                            "class": "btn btn-primary",
                                                                            "icon": "las la-save"
                                                                        },
                                                                        {
                                                                            "type": "button",
                                                                            "action": "link:sfw/email-templates",
                                                                            "title": "cancel",
                                                                            "class": "btn btn-secondary",
                                                                            "icon": "las la-times"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "translationFile": "sfwcomponent::"
}
