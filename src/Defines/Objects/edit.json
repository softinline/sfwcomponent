{
    "type": "screen",
    "layout": "sfwcomponent::backoffice.layouts.default",
    "ajax": false,
    "name": "edit",
    "url": "sfw/objects",
    "components": [
        {
            "type": "div",
            "class": "container-fluid",
            "components": [
                {
                    "type": "function",
                    "function": "breadcrumbEdit"
                },
                {
                    "type": "div",
                    "class": "row",
                    "components": [
                        {
                            "type": "div",
                            "class": "col-lg-12",
                            "components": [
                                {
                                    "type": "form",
                                    "id": "frm-sfw-objects-edit",
                                    "name": "frm-sfw-objects-edit",
                                    "action": "sfw/objects/{id}",
                                    "method": "POST",
                                    "components": [
                                        {
                                            "type": "div",
                                            "class": "card",
                                            "components": [
                                                {
                                                    "type": "div",
                                                    "class": "card-body",
                                                    "components": [
                                                        {
                                                            "type": "text",
                                                            "title": "key",
                                                            "field": "key",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "name",
                                                            "field": "name",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "type",
                                                            "field": "type"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "route",
                                                            "field": "route"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "parent_id",
                                                            "field": "parent_id"
                                                        },
                                                        {
                                                            "type": "text",
                                                            "title": "sort_order",
                                                            "field": "sort_order"
                                                        },
                                                        {
                                                            "type": "checkbox",
                                                            "title": "is_active",
                                                            "field": "is_active"
                                                        },
                                                        {
                                                            "type": "checkbox",
                                                            "title": "is_system",
                                                            "field": "system"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "class": "card-footer",
                                                    "components": [
                                                        {
                                                            "type": "button",
                                                            "action": "js:sfwcomponent.submit('frm-sfw-objects-edit')",
                                                            "title": "accept",
                                                            "class": "btn btn-primary",
                                                            "icon": "las la-save"
                                                        },
                                                        {
                                                            "type": "button",
                                                            "action": "link:sfw/objects",
                                                            "title": "cancel",
                                                            "class": "btn btn-secondary",
                                                            "icon": "las la-times"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "translationFile": "sfwcomponent::"
}
